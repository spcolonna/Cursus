# Copiá este archivo a android/key.properties (que NO se commitea) y completá.
# La keystore se crea una sola vez y se guarda con backup (ver docs/PUBLICAR.md):
#   keytool -genkey -v -keystore ~/cursus-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=
keyPassword=
keyAlias=upload
storeFile=/Users/TU_USUARIO/cursus-upload.jks
