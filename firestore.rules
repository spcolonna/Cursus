rules_version = '2';

// Cada jugador solo ve y escribe su partida (users/{uid}). Nada más es
// accesible desde la app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schemaVersion', 'revision', 'deviceId',
                                 'savedAt', 'summary', 'payload'])
          && d.schemaVersion is int
          && d.revision is int
          && d.deviceId is string && d.deviceId.size() < 64
          && d.savedAt == request.time
          && d.summary is map
          && d.payload is string && d.payload.size() < 900000;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validSave();
    }
  }
}
